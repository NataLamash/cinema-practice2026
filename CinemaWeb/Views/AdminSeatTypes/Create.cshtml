@model CinemaDomain.Model.SeatType

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">@(Model?.Id == 0 ? "Створення" : "Редагування") типу місця</h4>
                </div>
                <div class="card-body">
                    <form asp-action="@(Model?.Id == 0 ? "Create" : "Edit")">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        @if (Model?.Id != 0)
                        {
                            <input type="hidden" asp-for="Id" />
                        }

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label font-weight-bold">Назва типу</label>
                            <input asp-for="Name" class="form-control" placeholder="Напр: VIP, LoveSeats..." />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MarkUpInPercentage" class="form-label font-weight-bold">Націнка у відсотках (%)</label>
                            <input asp-for="MarkUpInPercentage" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="MarkUpInPercentage" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label font-weight-bold">Опис</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
                            <button type="submit" class="btn btn-success px-4">Зберегти</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
