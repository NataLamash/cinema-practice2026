@using System.Security.Claims
<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mystic Reel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/movies-grid.css" asp-append-version="true" />
</head>
<body class="app-dark">
    <header class="app-header">
        <div class="container app-navbar d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <a class="d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="20" height="20">
                            <path fill="white" d="M12 2a10 10 0 100 20 10 10 0 000-20zm0 2a8 8 0 110 16 8 8 0 010-16zm0 3a5 5 0 100 10 5 5 0 000-10zm0 2a3 3 0 110 6 3 3 0 010-6z" />
                        </svg>
                    </span>
                    <span class="brand-name">Mystic Reel</span>
                </a>

                <nav class="d-flex align-items-center gap-1">
                    <a class="app-nav-link" asp-controller="Movies" asp-action="Index">Фільми</a>
                    <a class="app-nav-link" asp-controller="Sessions" asp-action="Index">Сеанси</a>

                    @if (User?.Identity?.IsAuthenticated ?? false)
                    {
                        if (User.IsInRole("Admin"))
                        {
                            <span class="app-divider">|</span>
                            <a class="app-nav-link" asp-controller="AdminFilms" asp-action="Index">Адмін: фільми</a>
                            <a class="app-nav-link" asp-controller="AdminSessions" asp-action="Index">Адмін: сеанси</a>
                            <a class="app-nav-link" asp-controller="AdminOrders" asp-action="Index">Адмін: замовлення</a>
                            <a class="app-nav-link" asp-controller="AdminSeatTypes" asp-action="Index">Адмін: типи місць</a>
                        }
                    }
                </nav>
            </div>

            <div>
                <partial name="_LoginPartial" />
            </div>
        </div>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
