@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item app-auth-li">
        <div class="app-auth-row">
            <a class="app-auth-btn" asp-controller="Account" asp-action="Orders">Профіль</a>

            <form class="app-auth-form" asp-area="Identity" asp-page="/Account/Logout" method="post">
                <button type="submit" class="app-auth-btn app-auth-btn-outline">Вийти</button>
            </form>
        </div>
    </li>
}
else
{
    <li class="nav-item app-auth-li">
        <div class="app-auth-row">
            <a class="app-auth-btn" asp-area="Identity" asp-page="/Account/Register">Зареєструватися</a>
            <a class="app-auth-btn app-auth-btn-outline" asp-area="Identity" asp-page="/Account/Login">Увійти</a>
        </div>
    </li>
}
