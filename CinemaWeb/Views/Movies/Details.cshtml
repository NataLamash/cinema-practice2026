@model CinemaWeb.ViewModels.ClientFilmDetailsViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h2 class="mb-0">@Model.Title</h2>
            <span class="badge bg-warning text-dark">@(Model.AllowedMinAge ?? 0)+</span>
        </div>

        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <div class="text-center mb-4">
                        @if (!string.IsNullOrEmpty(Model.PosterUrl))
                        {
                            <img src="@Model.PosterUrl" alt="@Model.Title" class="img-fluid rounded shadow-sm" style="max-height: 500px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="alert alert-secondary py-5">Постер недоступний</div>
                        }
                    </div>

                    <div class="card mb-3 border-secondary">
                        <div class="card-header bg-light fw-bold text-center">
                            Найближчі сеанси
                        </div>

                        @if (Model.UpcomingSessions.Any())
                        {
                          <div class="list-group list-group-flush">
                            @foreach (var session in Model.UpcomingSessions)
                            {
                                <a asp-controller="Booking" 
                                   asp-action="SelectSeats" 
                                   asp-route-sessionId="@session.SessionId" 
                                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
            
                                    <div>
                                        <div class="fw-bold text-primary">
                                            @session.StartTime.ToString("d MMM") о @session.StartTime.ToString("HH:mm")
                                        </div>
                                        <small class="text-muted">@session.HallName</small>
                                    </div>
            
                                    <span class="badge bg-success rounded-pill">
                                        @session.BasePrice ₴
                                    </span>
            
                                </a>
                            }
                        </div>
                        }
                        else
                        {
                            <div class="card-body text-center text-muted">
                                <small>На жаль, активних сеансів немає.</small>
                            </div>
                        }

                        <div class="card-footer text-center bg-white border-top-0 pb-3">
                            <a asp-controller="Sessions"
                               asp-action="Index"
                               asp-route-filmId="@Model.Id"
                               class="btn btn-outline-primary btn-sm w-100">
                                <i class="bi bi-calendar3"></i> Повний розклад
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-md-8">
                    <dl class="row">
                        <dt class="col-sm-3">Опис:</dt>
                        <dd class="col-sm-9">
                            @(string.IsNullOrEmpty(Model.Description) ? "Дані відсутні" : Model.Description)
                        </dd>

                        <dt class="col-sm-3">Дата виходу:</dt>
                        <dd class="col-sm-9">
                            @(Model.ReleaseDate.HasValue
                                                        ? Model.ReleaseDate.Value.ToString("d MMMM, yyyy")
                                                        : "Дані відсутні")
                        </dd>

                        <dt class="col-sm-3">Тривалість:</dt>
                        <dd class="col-sm-9">@Model.DurationMinutes хв.</dd>

                        <dt class="col-sm-3">Продюсер:</dt>
                        <dd class="col-sm-9">@(Model.ProducerName ?? "Дані відсутні")</dd>

                        <hr class="my-3" />

                        <dt class="col-sm-3">Жанри:</dt>
                        <dd class="col-sm-9">
                            @if (Model.Genres.Any())
                            {
                                @foreach (var genre in Model.Genres)
                                {
                                    <span class="badge bg-secondary me-1">@genre</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">Дані відсутні</span>
                            }
                        </dd>

                        <dt class="col-sm-3">Актори:</dt>
                        <dd class="col-sm-9">
                            @if (Model.Actors.Any())
                            {
                                <ul class="list-unstyled mb-0">
                                    @foreach (var actor in Model.Actors)
                                    {
                                        <li>
                                            <i class="bi bi-person-fill text-muted"></i> @actor
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <span class="text-muted">Дані відсутні</span>
                            }
                        </dd>

                        <dt class="col-sm-3">Виробники:</dt>
                        <dd class="col-sm-9">
                            @if (Model.Companies.Any())
                            {
                                <ul class="list-unstyled mb-0">
                                    @foreach (var company in Model.Companies)
                                    {
                                        <li>@company</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <span class="text-muted">Дані відсутні</span>
                            }
                        </dd>

                        <hr class="my-3" />

                        <dt class="col-sm-3">Трейлер:</dt>
                        <dd class="col-sm-9">
                            @if (!string.IsNullOrEmpty(Model.TrailerEmbedUrl))
                            {
                                <div class="mt-1">
                                    <div class="ratio ratio-16x9 shadow-sm rounded overflow-hidden">
                                        <iframe src="@Model.TrailerEmbedUrl"
                                                title="YouTube video player"
                                                frameborder="0"
                                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                                allowfullscreen>
                                        </iframe>
                                    </div>
                                </div>
                            }
                            else if (!string.IsNullOrEmpty(Model.TrailerUrl))
                            {
                                <div class="mt-1">
                                    <a href="@Model.TrailerUrl" target="_blank" class="btn btn-danger w-100">
                                        <i class="bi bi-youtube"></i> Дивитися трейлер
                                    </a>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">Дані відсутні</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="card-footer text-end">
            <a asp-action="Index" class="btn btn-outline-secondary">Назад до фільмів</a>
        </div>
    </div>
</div>
