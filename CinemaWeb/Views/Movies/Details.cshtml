@model CinemaWeb.ViewModels.ClientFilmDetailsViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4 mb-5">
    <div class="card shadow-lg border-0 overflow-hidden">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
            <h2 class="mb-0 fw-bold">@Model.Title</h2>
            <span class="badge bg-warning text-dark fs-6 px-3">@(Model.AllowedMinAge ?? 0)+</span>
        </div>

        <div class="card-body p-4">
            <div class="row">
                <div class="col-md-4">
                    <div class="text-center mb-4">
                        @if (!string.IsNullOrEmpty(Model.PosterUrl))
                        {
                            <img src="@Model.PosterUrl" alt="@Model.Title" class="img-fluid rounded shadow-sm w-100" style="max-height: 550px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-light py-5 rounded text-muted border">Постер недоступний</div>
                        }
                    </div>

                    <div class="card border-0 bg-light">
                        <div class="card-header bg-secondary text-white fw-bold text-center border-0">
                            Найближчі сеанси
                        </div>
                        <div class="card-body p-3">
                            @if (Model.UpcomingSessions.Any())
                            {
                                <div class="row g-2">
                                    @foreach (var session in Model.UpcomingSessions)
                                    {
                                        <div class="col-6">
                                            <a asp-controller="Booking" 
                                               asp-action="SelectSeats" 
                                               asp-route-sessionId="@session.SessionId" 
                                               class="text-decoration-none" />
                                            <div class="card h-100 border-0 shadow-sm text-center p-2">
                                                <div class="fw-bold fs-3 text-primary line-height-1">
                                                    @session.StartTime.ToString("HH:mm")
                                                </div>
                                                <div class="text-uppercase fw-bold text-muted mt-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">
                                                    @session.HallName
                                                </div>
                                                <div class="mt-2">
                                                    <span class="badge bg-success py-1 px-2">@session.BasePrice ₴</span>
                                                </div>
                                                <div class="text-muted mt-1" style="font-size: 0.7rem;">
                                                    @session.StartTime.ToString("dd MMM")
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted py-3 small">На жаль, активних сеансів немає.</div>
                            }
                        </div>
                        <div class="card-footer bg-transparent border-0 text-center pb-3">
                            <a asp-controller="Sessions" asp-action="Index" asp-route-filmId="@Model.Id"
                               class="btn btn-sm btn-outline-dark w-100">
                                <i class="bi bi-calendar3"></i> Повний розклад
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-md-8 px-md-4">
                    <h4 class="fw-bold mb-3 border-bottom pb-2">Про фільм</h4>
                    <dl class="row">
                        <dt class="col-sm-3 text-muted">Опис</dt>
                        <dd class="col-sm-9 mb-4">@(string.IsNullOrEmpty(Model.Description) ? "Опис відсутній." : Model.Description)</dd>

                        <dt class="col-sm-3 text-muted">Дата виходу</dt>
                        <dd class="col-sm-9">@(Model.ReleaseDate?.ToString("d MMMM, yyyy") ?? "Невідомо")</dd>

                        <dt class="col-sm-3 text-muted">Тривалість</dt>
                        <dd class="col-sm-9">@Model.DurationMinutes хв.</dd>

                        <dt class="col-sm-3 text-muted">Продюсер</dt>
                        <dd class="col-sm-9">@(Model.ProducerName ?? "Не вказано")</dd>

                        <dt class="col-sm-3 text-muted mt-2">Жанри</dt>
                        <dd class="col-sm-9 mt-2">
                            @foreach (var genre in Model.Genres)
                            {
                                <span class="badge bg-outline-secondary border text-dark me-1">@genre</span>
                            }
                        </dd>
                    </dl>

                    @if (!string.IsNullOrEmpty(Model.TrailerEmbedUrl))
                    {
                        <div class="mt-4">
                            <h5 class="fw-bold mb-3"><i class="bi bi-play-circle-fill"></i> Трейлер</h5>
                            <div class="ratio ratio-16x9 rounded shadow-sm overflow-hidden">
                                <iframe src="@Model.TrailerEmbedUrl" allowfullscreen></iframe>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="card-footer bg-light p-3 text-end">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Назад до афіші
            </a>
        </div>
    </div>
</div>

<style>
    .line-height-1 {
        line-height: 1.1;
    }
</style>
