@model IEnumerable<CinemaDomain.Model.Session>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Керування сеансами</h2>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg"></i> Додати новий сеанс
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="table-responsive shadow-sm">
        <table class="table table-hover border align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Фільм</th>
                    <th>Зал</th>
                    <th>Початок</th>
                    <th>Кінець</th>
                    <th>Ціна</th>
                    <th class="text-center">Дії</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <strong>@(item.Film?.Name ?? "Фільм не вказано")</strong>
                        </td>
                        <td>@(item.Hall?.Name ?? "Зал не вказано")</td>
                        <td>@item.StartTime.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@item.EndTime.ToString("HH:mm")</td>
                        <td>
                            <span class="badge bg-light text-dark border">
                                @item.BasePrice.ToString("F2") грн
                            </span>
                        </td>
                        <td class="text-center">
                            <div class="d-flex justify-content-center gap-2">

                                <a asp-action="Edit" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-warning">
                                    <i class="bi bi-pencil-square"></i> Редагувати
                                </a>

                                <a asp-action="Details" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-info text-white">
                                    <i class="bi bi-info-circle"></i> Деталі ціни
                                </a>

                                <form asp-action="Delete" asp-route-id="@item.Id" method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Ви впевнені, що хочете видалити цей сеанс? Цю дію неможливо буде скасувати.')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i> Видалити
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            Сеанси відсутні. Натисніть "Додати новий сеанс", щоб створити перший запис.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
